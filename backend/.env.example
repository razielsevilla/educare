# Copy this file to .env and fill in real values. Never commit .env.

# Port the Express server listens on.
PORT=3000

# Secret used to sign teacher session JWTs. If unset, the server generates a random
# secret at startup (logged as a warning) — fine for a single local dev run, but every
# restart invalidates all issued tokens. Set a stable value for anything long-running:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Comma-separated list of origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,http://localhost:3000,http://127.0.0.1:3000
