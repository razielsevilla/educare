# The base URL for the backend API.
# If running the backend locally for testing on devices (like Android),
# set this to your local machine's IP address (e.g. http://192.168.1.100:3000/api).
# If this is not set, it defaults to http://127.0.0.1:3000/api for local testing.
VITE_API_BASE_URL=http://127.0.0.1:3000/api
